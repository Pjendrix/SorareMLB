# ---- Sorare ----
SORARE_API_KEY=
SORARE_EMAIL=
SORARE_PASSWORD=
SORARE_JWT_AUD=sorare-mlb-lineups

# Volitelné: TOTP secret pro plně automatické přihlášení bez zadávání kódu.
# POZOR: tím se z 2FA stává 1FA — oba faktory pak leží na stejném místě.
# Nech prázdné a přihlašuj se přes /login, pokud nemáš dobrý důvod.
SORARE_TOTP_SECRET=

# ---- Ochrana endpointů ----
# Vygeneruj: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SECRET=

# ---- Úložiště (Upstash Redis přes Vercel Marketplace) ----
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Základ pro navazování kroků ----
# Na Vercelu se dopočítá z VERCEL_URL, ale vlastní doména je spolehlivější.
APP_BASE_URL=https://tvuj-projekt.vercel.app

# ---- Notifikace (stačí jedna varianta) ----
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Chování cronu ----
# auto = navrhne i odešle, propose = jen navrhne a pošle notifikaci
CRON_MODE=auto
STEP_BUDGET_SECONDS=40
