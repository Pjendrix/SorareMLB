# Sorare API klíč (zvyšuje rate limit, posílá se v hlavičce APIKEY)
SORARE_API_KEY=

# Libovolný identifikátor tvé aplikace. MUSÍ být stejný při signIn i u všech
# dalších requestů (posílá se jako JWT-AUD).
SORARE_JWT_AUD=sorare-mlb-lineups

# --- Varianta A: přihlášení e-mailem a heslem ---
SORARE_EMAIL=
SORARE_PASSWORD=

# --- Varianta B: OAuth "Login with Sorare" ---
SORARE_OAUTH_CLIENT_ID=
SORARE_OAUTH_CLIENT_SECRET=
SORARE_OAUTH_REDIRECT_PORT=8731
